{
  "name": "sal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "inspect": "bun run inspect:file AGENTS.md package.json",
    "inspect:file": "bun scripts/read.ts",
    "inspect:search": "rg",
    "inspect:files": "rg --files",
    "research:read:sbr": "bun scripts/sbr-documents.ts",
    "git:init": "git init",
    "git:status": "git status --short",
    "git:diff": "git diff",
    "git:check": "git diff --check",
    "git:stage": "git add -- .",
    "git:commit": "git commit",
    "git:log": "git log",
    "dependencies:lock": "bun scripts/install.ts update-lockfile",
    "dependencies:install": "bun scripts/install.ts frozen-lockfile",
    "dependencies:help": "bun install --help",
    "dependencies:info:coverage": "bun info v8-to-istanbul",
    "config:inventory:biome": "bun scripts/biome-inventory.ts write",
    "config:check:biome": "bun scripts/biome-inventory.ts check",
    "config:inventory:tools": "bun scripts/config-inventory.ts write",
    "config:check:tools": "bun scripts/config-inventory.ts check",
    "config:check:sources": "bun scripts/config-sources.ts",
    "config:check:files": "bun scripts/file-configurations.ts",
    "config:check": "bun run config:check:sources && bun run config:check:files && bun run config:check:biome && bun run config:check:tools",
    "check": "bun run config:check && bun run biome:check && bun run typecheck && bun run coverage && bun run test:browser && bun run git:check",
    "format": "bun --bun node_modules/@biomejs/biome/bin/biome format --write --error-on-warnings .",
    "format:files": "bun --bun node_modules/@biomejs/biome/bin/biome format --write --error-on-warnings",
    "format:check": "bun --bun node_modules/@biomejs/biome/bin/biome format --error-on-warnings .",
    "format:stdin": "bun --bun node_modules/@biomejs/biome/bin/biome format --stdin-file-path=compatibility.svelte",
    "lint:stdin": "bun --bun node_modules/@biomejs/biome/bin/biome lint --stdin-file-path=compatibility.svelte",
    "lint:fixture": "bun --bun node_modules/@biomejs/biome/bin/biome lint --config-path=. --vcs-enabled=false",
    "lint": "bun --bun node_modules/@biomejs/biome/bin/biome lint --error-on-warnings .",
    "biome:check": "bun --bun node_modules/@biomejs/biome/bin/biome check --error-on-warnings .",
    "biome:check:files": "bun --bun node_modules/@biomejs/biome/bin/biome check --error-on-warnings",
    "biome:fix": "bun --bun node_modules/@biomejs/biome/bin/biome check --write --error-on-warnings .",
    "biome:fix:files": "bun --bun node_modules/@biomejs/biome/bin/biome check --write --error-on-warnings",
    "test": "bun run test:tooling && bun run test:calculations && bun run test:data",
    "test:calculations": "bun test tests/calculations",
    "test:data": "bun test tests/data",
    "test:application": "bun test tests/measurement",
    "test:calculator": "bun test tests/tooling/calculator.test.ts",
    "test:formulas": "bun test tests/data/formulas.test.ts tests/data/formula-records.test.ts tests/data/formula-equations.test.ts",
    "test:browser:formulas": "bun test tests/browser/formulas.test.ts",
    "test:browser:formulas:dev": "bun test tests/development/formulas.test.ts",
    "test:browser:calculator": "bun test tests/browser/calculator.test.ts",
    "test:browser:calculator:dev": "bun test tests/development/calculator.test.ts",
    "test:ui-state": "bun test tests/data/ui-state.test.ts",
    "test:browser:settings": "bun test tests/browser/settings.test.ts",
    "test:browser:settings:dev": "bun test tests/development/settings.test.ts",
    "test:browser:shortcuts": "bun test tests/browser/shortcuts.test.ts",
    "test:browser:controls:dev": "bun test tests/development/shortcut-controls.test.ts",
    "test:browser:compact:dev": "bun test tests/development/compact.test.ts",
    "test:browser:compact": "bun test tests/browser/compact.test.ts",
    "test:browser:review:dev": "bun test tests/development/review.test.ts",
    "test:browser:width:dev": "bun test tests/development/page-width.test.ts",
    "test:browser:state:dev": "bun test tests/development/ui-state.test.ts",
    "test:browser": "bun run build && bun test tests/browser",
    "test:browser:static": "bun test tests/browser/static-build.test.ts",
    "test:browser:layout": "bun test tests/browser/comparison-layout.test.ts",
    "test:browser:typography": "bun test tests/browser/typography.test.ts",
    "test:browser:comparison-inspector": "bun test tests/browser/comparison-inspector.test.ts",
    "test:browser:combobox": "bun test tests/browser/combobox.test.ts",
    "test:browser:offer-actions": "bun test tests/browser/offer-actions.test.ts",
    "coverage": "bun run coverage:collect && bun run coverage:check",
    "coverage:collect": "bun run coverage:bun && bun run coverage:browser",
    "coverage:bun": "bun test --config=bunfig.coverage.toml tests/tooling tests/calculations tests/data",
    "coverage:browser": "bun test tests/measurement",
    "coverage:check": "bun scripts/coverage.ts",
    "test:coverage:gate": "bun test tests/tooling/coverage.test.ts tests/tooling/coverage-provider.test.ts",
    "test:tooling": "bun test tests/tooling",
    "test:research:sbr": "bun test tests/tooling/sbr-documents.test.ts",
    "test:servers": "bun run build && bun test tests/browser/servers.test.ts",
    "test:servers:built": "bun test tests/browser/servers.test.ts",
    "test:browser:compatibility": "bun test tests/browser/compatibility.test.ts",
    "test:browser:coverage": "bun test tests/browser/coverage-compatibility.test.ts",
    "browsers:install": "bun --bun node_modules/playwright/cli.js install firefox",
    "browsers:install:all": "bun --bun node_modules/playwright/cli.js install chrome firefox",
    "browsers:install:pages": "bun --bun node_modules/playwright/cli.js install --with-deps chrome firefox",
    "dev": "bun scripts/vite.ts dev",
    "sync": "bun --bun node_modules/@sveltejs/kit/src/cli.js sync",
    "build": "bun scripts/vite.ts build",
    "build:pages": "bun scripts/vite.ts build --mode github-pages",
    "pages:validate": "bun scripts/github-pages.ts",
    "test:pages": "bun test tests/tooling/github-pages.test.ts",
    "test:browser:pages": "bun test tests/github-pages/browser.test.ts",
    "preview": "bun scripts/vite.ts preview",
    "typecheck": "bun run sync && bun run typecheck:svelte && bun run typecheck:typescript && bun run typecheck:tools && bun run typecheck:worker",
    "typecheck:worker": "bun --bun node_modules/typescript/bin/tsc --project tsconfig.worker.json",
    "typecheck:svelte": "bun --bun node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "typecheck:typescript": "bun --bun node_modules/typescript/bin/tsc --project tsconfig.json",
    "typecheck:tools": "bun --bun node_modules/typescript/bin/tsc --project tsconfig.tools.json",
    "typescript:options": "bun --bun node_modules/typescript/bin/tsc --all",
    "biome:help": "bun --bun node_modules/@biomejs/biome/bin/biome --help",
    "biome:inspect": "bun --bun node_modules/@biomejs/biome/bin/biome inspect",
    "biome:explain": "bun --bun node_modules/@biomejs/biome/bin/biome explain",
    "source:biome": "git clone --depth 1 --branch @biomejs/biome@2.6.2 https://github.com/biomejs/biome.git .cache/biome",
    "source:biome:refs": "git ls-remote --tags https://github.com/biomejs/biome.git"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@jridgewell/trace-mapping": "0.3.31",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/bun": "1.4.4",
    "playwright": "1.64.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "v8-to-istanbul": "9.3.0",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@primeicons/svelte": "8.0.2"
  }
}
